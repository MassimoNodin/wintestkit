<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Snoop CLR host loads only the named assembly from outside the target
       app directory. Compile the shared codec into that assembly so resolving
       its first dependency does not depend on the target's probing paths. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>WinTestKit.Inspector.Agent</AssemblyName>
    <RootNamespace>WinTestKit.Inspector.Agent</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../WinTestKit.Inspector.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)BundledAgent.packages.lock.json</NuGetLockFilePath>
    <OutputPath>../../artifacts/bundled-agent/bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Agent/**/*.cs" Exclude="../Agent/bin/**/*.cs;../Agent/obj/**/*.cs" />
    <Compile Include="../Protocol/**/*.cs" Exclude="../Protocol/bin/**/*.cs;../Protocol/obj/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
</Project>

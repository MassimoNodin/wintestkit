{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wintestkit.dev/wpf-inspector/protocol/inspector.schema.json",
  "$defs": {
    "Identifier": {"type":"string","minLength":1,"maxLength":128},
    "Key": {"type":"string","minLength":1,"maxLength":1024},
    "TypeName": {"type":"string","maxLength":1024},
    "ScalarString": {"type":"string","maxLength":4096},
    "RuntimeId": {"type":"array","minItems":1,"maxItems":1024,"items":{"type":"integer","minimum":-2147483648,"maximum":2147483647}},
    "Features": {"type":"array","maxItems":200,"items":{"enum":["typeMetadata","clrMembers","dependencyProperties","bindings","exactUiaMapping","batchReads"]}},
    "ProcessIdentity": {"type":"object","properties":{"pid":{"type":"integer","minimum":1},"creationTimeUtc":{"type":"string","format":"date-time","maxLength":128}},"required":["pid","creationTimeUtc"],"additionalProperties":false},
    "Session": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"process":{"$ref":"#/$defs/ProcessIdentity"},"state":{"enum":["detached","probing","attaching","ready","detaching","faulted","exited"]},"protocolMajor":{"type":"integer","minimum":0},"protocolMinor":{"type":"integer","minimum":0},"features":{"$ref":"#/$defs/Features"},"runtimeVersion":{"$ref":"#/$defs/Identifier"},"architecture":{"$ref":"#/$defs/Identifier"},"agentVersion":{"$ref":"#/$defs/Identifier"},"error":{"type":"string","minLength":1,"maxLength":1024}},"required":["sessionId","process","state","protocolMajor","protocolMinor","features"],"additionalProperties":false},
    "TypeInfo": {"type":"object","properties":{"name":{"$ref":"#/$defs/TypeName"},"fullName":{"$ref":"#/$defs/TypeName"},"assemblyName":{"$ref":"#/$defs/TypeName"},"assemblyQualifiedName":{"$ref":"#/$defs/TypeName"},"baseTypes":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/TypeName"}}},"required":["name","fullName","assemblyName","assemblyQualifiedName","baseTypes"],"additionalProperties":false},
    "ObjectRef": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectId":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"type":{"$ref":"#/$defs/TypeInfo"},"dispatcherId":{"$ref":"#/$defs/Identifier"}},"required":["sessionId","objectId","generation","type","dispatcherId"],"additionalProperties":false},
    "DependencyMetadata": {"type":"object","properties":{"ownerType":{"$ref":"#/$defs/Key"},"ownerAssembly":{"$ref":"#/$defs/Key"},"propertyType":{"$ref":"#/$defs/Key"},"readOnly":{"type":"boolean"},"isAttached":{"enum":["true","false","unknown"]},"hasLocalValue":{"type":"boolean"},"metadataFlags":{"type":"array","maxItems":32,"items":{"enum":["None","AffectsMeasure","AffectsArrange","AffectsParentMeasure","AffectsParentArrange","AffectsRender","Inherits","OverridesInheritanceBehavior","NotDataBindable","BindsTwoWayByDefault","Journal","SubPropertiesDoNotAffectRender"]}}},"required":["ownerType","ownerAssembly","propertyType","readOnly","isAttached","hasLocalValue","metadataFlags"],"additionalProperties":false},
    "AttributeLiteral": {"type":"object","properties":{"kind":{"enum":["string","enum","type","boolean","integer","number","null","array"]},"value":{}},"required":["kind","value"],"additionalProperties":false,"allOf":[
      {"if":{"properties":{"kind":{"const":"string"}}},"then":{"properties":{"value":{"$ref":"#/$defs/ScalarString"}}}},
      {"if":{"properties":{"kind":{"enum":["enum","type"]}}},"then":{"properties":{"value":{"$ref":"#/$defs/Key"}}}},
      {"if":{"properties":{"kind":{"const":"boolean"}}},"then":{"properties":{"value":{"type":"boolean"}}}},
      {"if":{"properties":{"kind":{"const":"integer"}}},"then":{"properties":{"value":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807}}}},
      {"if":{"properties":{"kind":{"const":"number"}}},"then":{"properties":{"value":{"type":"number"}}}},
      {"if":{"properties":{"kind":{"const":"null"}}},"then":{"properties":{"value":{"type":"null"}}}},
      {"if":{"properties":{"kind":{"const":"array"}}},"then":{"properties":{"value":{"type":"array","maxItems":32,"items":{"allOf":[{"$ref":"#/$defs/AttributeLiteral"},{"properties":{"kind":{"not":{"const":"array"}}}}]}}}}}
    ]},
    "AttributeInfo": {"type":"object","properties":{"typeName":{"$ref":"#/$defs/Key"},"constructorArguments":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/AttributeLiteral"}},"namedArguments":{"type":"object","maxProperties":32,"propertyNames":{"$ref":"#/$defs/Identifier"},"additionalProperties":{"$ref":"#/$defs/AttributeLiteral"}}},"required":["typeName","constructorArguments","namedArguments"],"additionalProperties":false},
    "PathSegment": {"oneOf":[
      {"type":"object","properties":{"kind":{"const":"property"},"name":{"$ref":"#/$defs/Key"},"declaringType":{"$ref":"#/$defs/Key"},"memberKey":{"$ref":"#/$defs/Key"}},"required":["kind","name"],"additionalProperties":false},
      {"type":"object","properties":{"kind":{"const":"field"},"name":{"$ref":"#/$defs/Key"},"declaringType":{"$ref":"#/$defs/Key"},"memberKey":{"$ref":"#/$defs/Key"}},"required":["kind","name"],"additionalProperties":false},
      {"type":"object","properties":{"kind":{"const":"dependency"},"ownerType":{"$ref":"#/$defs/Key"},"ownerAssembly":{"$ref":"#/$defs/Key"},"name":{"$ref":"#/$defs/Key"}},"required":["kind","ownerType","ownerAssembly","name"],"additionalProperties":false},
      {"type":"object","properties":{"kind":{"const":"type"},"name":{"enum":["Name","FullName","AssemblyName","AssemblyQualifiedName","BaseTypes"]}},"required":["kind","name"],"additionalProperties":false}
    ]},
    "Path": {"description":"A type segment must be alone. Serialized paths must not exceed 1024 UTF-8 bytes.","type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/PathSegment"},"allOf":[{"if":{"contains":{"properties":{"kind":{"const":"type"}},"required":["kind"]}},"then":{"maxItems":1}}]},
    "Member": {"type":"object","properties":{"memberKey":{"$ref":"#/$defs/Key"},"name":{"$ref":"#/$defs/Key"},"category":{"enum":["typeMetadata","clrProperty","clrField","dependencyProperty","attachedProperty"]},"declaringType":{"$ref":"#/$defs/TypeName"},"declaredType":{"$ref":"#/$defs/TypeName"},"visibility":{"enum":["public","protected","internal","private","protectedInternal","privateProtected"]},"readable":{"type":"boolean"},"attributes":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/AttributeInfo"}},"pathSegment":{"$ref":"#/$defs/PathSegment"},"dependency":{"$ref":"#/$defs/DependencyMetadata"},"reason":{"enum":["nonPublic","writeOnly","indexer","static","unsupportedType","ambiguous"]},"wrapperKey":{"$ref":"#/$defs/Key"},"compatibilityAlias":{"$ref":"#/$defs/Identifier"}},"required":["memberKey","name","category","declaringType","declaredType","visibility","readable","attributes"],"additionalProperties":false},
    "DependencySource": {"type":"object","properties":{"baseValueSource":{"enum":["Unknown","Default","Inherited","DefaultStyle","DefaultStyleTrigger","Style","TemplateTrigger","StyleTrigger","ImplicitStyleReference","ParentTemplate","ParentTemplateTrigger","Local"]},"isExpression":{"type":"boolean"},"isAnimated":{"type":"boolean"},"isCoerced":{"type":"boolean"},"isCurrent":{"type":"boolean"}},"required":["baseValueSource","isExpression","isAnimated","isCoerced","isCurrent"],"additionalProperties":false},
    "Value": {"type":"object","properties":{"status":{"enum":["ok","notRead","notReadable","nullIntermediate","exception","stale","redacted","truncated","cycle","timeout","unsupported"]},"kind":{"enum":["null","string","boolean","integer","number","enum","object","array","type","unavailable"]},"declaredType":{"$ref":"#/$defs/TypeName"},"runtimeType":{"$ref":"#/$defs/TypeName"},"scalar":{"oneOf":[{"type":"null"},{"type":"boolean"},{"type":"number"},{"$ref":"#/$defs/ScalarString"}]},"object":{"$ref":"#/$defs/ObjectRef"},"message":{"type":"string","maxLength":1024},"truncatedAt":{"type":"integer","minimum":1},"cycleTo":{"$ref":"#/$defs/ObjectRef"},"numericValue":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^-?(0|[1-9][0-9]*)$"},"typeInfo":{"$ref":"#/$defs/TypeInfo"},"arrayRank":{"type":"integer","minimum":1},"arrayLength":{"type":"integer","minimum":0},"failedSegment":{"type":"integer","minimum":0,"maximum":7},"redactionRule":{"$ref":"#/$defs/Key"},"dependencySource":{"$ref":"#/$defs/DependencySource"}},"required":["status","kind","declaredType","runtimeType"],"additionalProperties":false,"description":"For truncated values truncatedAt is greater than the Unicode scalar length of scalar; dependencySource is present only for dependency reads.","allOf":[
      {"if":{"properties":{"status":{"const":"ok"}}},"then":{"properties":{"kind":{"not":{"const":"unavailable"}}},"not":{"anyOf":[{"required":["cycleTo"]},{"required":["truncatedAt"]},{"required":["failedSegment"]}]}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"enum":["null","string","boolean","integer","number","enum"]}}},"then":{"required":["scalar"],"not":{"required":["object"]}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"enum":["object","array"]}}},"then":{"required":["object"],"not":{"required":["scalar"]}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"type"}}},"then":{"required":["typeInfo"],"not":{"anyOf":[{"required":["scalar"]},{"required":["object"]}]}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"null"}}},"then":{"properties":{"scalar":{"type":"null"}}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"enum":["string","enum"]}}},"then":{"properties":{"scalar":{"type":"string"}}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"boolean"}}},"then":{"properties":{"scalar":{"type":"boolean"}}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"integer"}}},"then":{"properties":{"scalar":{"oneOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"string","pattern":"^-?(0|[1-9][0-9]*)$","maxLength":4096}]}}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"number"}}},"then":{"properties":{"scalar":{"oneOf":[{"type":"number"},{"type":"string","maxLength":4096,"pattern":"^(NaN|Infinity|-Infinity|-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?)$"}]}}}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"enum"}}},"then":{"required":["numericValue"]}},
      {"if":{"properties":{"status":{"const":"ok"},"kind":{"const":"array"}}},"then":{"required":["arrayRank","arrayLength"]},"else":{"not":{"anyOf":[{"required":["arrayRank"]},{"required":["arrayLength"]}]}}},
      {"if":{"properties":{"status":{"const":"truncated"}}},"then":{"properties":{"kind":{"const":"string"},"scalar":{"type":"string"}},"required":["scalar","truncatedAt"],"not":{"anyOf":[{"required":["object"]},{"required":["cycleTo"]},{"required":["failedSegment"]}]}}},
      {"if":{"properties":{"status":{"const":"cycle"}}},"then":{"required":["cycleTo"],"not":{"anyOf":[{"required":["scalar"]},{"required":["object"]},{"required":["truncatedAt"]},{"required":["failedSegment"]}]}}},
      {"if":{"properties":{"status":{"not":{"enum":["ok","cycle","truncated"]}}}},"then":{"properties":{"kind":{"const":"unavailable"}},"not":{"anyOf":[{"required":["scalar"]},{"required":["object"]},{"required":["cycleTo"]},{"required":["truncatedAt"]},{"required":["dependencySource"]}]}}},
      {"if":{"properties":{"status":{"enum":["nullIntermediate","exception"]}}},"then":{"required":["failedSegment"]},"else":{"not":{"required":["failedSegment"]}}},
      {"if":{"properties":{"status":{"not":{"const":"ok"}}}},"then":{"not":{"required":["numericValue"]}}},
      {"if":{"required":["redactionRule"]},"then":{"properties":{"status":{"const":"redacted"}}}}
    ]},
    "Diagnostic": {"type":"object","properties":{"code":{"$ref":"#/$defs/Identifier"},"message":{"type":"string","maxLength":1024},"category":{"$ref":"#/$defs/Identifier"}},"required":["code","message"],"additionalProperties":false},
    "MemberPage": {"description":"nextToken is present iff further items exist; incomplete pages may instead indicate partial failure.","type":"object","properties":{"items":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/Member"}},"complete":{"type":"boolean"},"snapshotId":{"$ref":"#/$defs/Identifier"},"diagnostics":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/Diagnostic"}},"nextToken":{"$ref":"#/$defs/Identifier"}},"required":["items","complete","snapshotId","diagnostics"],"additionalProperties":false,"allOf":[{"if":{"properties":{"complete":{"const":true}}},"then":{"not":{"required":["nextToken"]}}}]},
    "ManagedNodePage": {"description":"nextToken is present iff further items exist; incomplete pages may instead indicate partial failure.","type":"object","properties":{"items":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/ManagedNode"}},"complete":{"type":"boolean"},"snapshotId":{"$ref":"#/$defs/Identifier"},"diagnostics":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/Diagnostic"}},"nextToken":{"$ref":"#/$defs/Identifier"}},"required":["items","complete","snapshotId","diagnostics"],"additionalProperties":false,"allOf":[{"if":{"properties":{"complete":{"const":true}}},"then":{"not":{"required":["nextToken"]}}}]},
    "Mapping": {"type":"object","properties":{"status":{"enum":["exact","notFound","ambiguous","unsupportedPeer","stale","limitExceeded"]},"process":{"$ref":"#/$defs/ProcessIdentity"},"runtimeId":{"$ref":"#/$defs/RuntimeId"},"object":{"$ref":"#/$defs/ObjectRef"}},"required":["status","process","runtimeId"],"additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"const":"exact"}}},"then":{"required":["object"]},"else":{"not":{"required":["object"]}}}]},
    "ManagedNode": {"type":"object","properties":{"object":{"$ref":"#/$defs/ObjectRef"},"label":{"type":"string","maxLength":1024},"hasVisualChildren":{"type":"boolean"},"hasLogicalChildren":{"type":"boolean"},"runtimeId":{"$ref":"#/$defs/RuntimeId"}},"required":["object","label","hasVisualChildren","hasLogicalChildren"],"additionalProperties":false},
    "RelativeSource": {"type":"object","properties":{"mode":{"enum":["FindAncestor","PreviousData","TemplatedParent","Self"]},"ancestorType":{"$ref":"#/$defs/Key"},"ancestorLevel":{"type":"integer","minimum":1,"maximum":2147483647}},"required":["mode"],"additionalProperties":false},
    "BindingInfo": {"description":"Recursive binding trees have maximum depth 8 and 32 total entries.","type":"object","properties":{"memberKey":{"$ref":"#/$defs/Key"},"kind":{"enum":["none","binding","multiBinding","priorityBinding"]},"status":{"type":"string","maxLength":128},"mode":{"type":"string","maxLength":128},"updateSourceTrigger":{"type":"string","maxLength":128},"path":{"type":"string","maxLength":1024},"elementName":{"type":"string","maxLength":1024},"relativeSource":{"$ref":"#/$defs/RelativeSource"},"sourceType":{"$ref":"#/$defs/Key"},"converterType":{"$ref":"#/$defs/Key"},"children":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/BindingInfo"}},"validationErrors":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/Key"}}},"required":["memberKey","kind","status","mode","updateSourceTrigger"],"additionalProperties":false,"allOf":[{"if":{"properties":{"kind":{"const":"none"}}},"then":{"properties":{"status":{"const":""},"mode":{"const":""},"updateSourceTrigger":{"const":""}}}}]},
    "PathValue": {"type":"object","properties":{"path":{"$ref":"#/$defs/Path"},"value":{"$ref":"#/$defs/Value"}},"required":["path","value"],"additionalProperties":false},
    "ReadResult": {"type":"object","properties":{"values":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/PathValue"}},"readId":{"$ref":"#/$defs/Identifier"}},"required":["values","readId"],"additionalProperties":false},
    "CandidateRequest": {"type":"object","properties":{"runtimeId":{"$ref":"#/$defs/RuntimeId"},"nativeWindowHandle":{"type":"integer"}},"required":["runtimeId"],"additionalProperties":false},
    "CandidateResult": {"type":"object","properties":{"runtimeId":{"$ref":"#/$defs/RuntimeId"},"mapping":{"$ref":"#/$defs/Mapping"},"values":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/PathValue"}}},"required":["runtimeId","mapping","values"],"additionalProperties":false,"allOf":[{"if":{"properties":{"mapping":{"properties":{"status":{"not":{"const":"exact"}}}}}},"then":{"properties":{"values":{"maxItems":0}}}}]},
    "ReadBatchResult": {"type":"object","properties":{"candidates":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/CandidateResult"}}},"required":["candidates"],"additionalProperties":false},
    "ErrorInfo": {"type":"object","properties":{"code":{"enum":["invalidParams","unsupportedProtocol","unsupportedTarget","accessDenied","authenticationFailed","payloadMissing","payloadMismatch","alreadyAttached","notAttached","attachFailed","blockedByPolicy","agentVersionMismatch","processExited","processReused","sessionStale","objectStale","mappingFailed","memberAmbiguous","memberNotFound","dispatcherUnavailable","timeout","busy","limitExceeded","invalidPageToken","cancelled","internalError"]},"message":{"type":"string","maxLength":1024},"details":{"type":"object"}},"required":["code","message"],"additionalProperties":false},
    "RequestEnvelope": {"type":"object","properties":{"id":{"type":"integer","minimum":1},"method":{"enum":["session.hello","session.close","request.cancel","element.resolve","element.readBatch","roots","children","members","read","bindings","release"]},"params":{"type":"object"}},"required":["id","method","params"],"additionalProperties":false},
    "ResponseEnvelope": {"type":"object","properties":{"id":{"type":"integer","minimum":1},"result":{},"error":{"$ref":"#/$defs/ErrorInfo"}},"required":["id"],"oneOf":[{"required":["result"]},{"required":["error"]}],"additionalProperties":false},
    "HelloParams": {"type":"object","properties":{"protocolMajor":{"const":1},"protocolMinor":{"type":"integer","minimum":0},"sessionId":{"$ref":"#/$defs/Identifier"},"token":{"$ref":"#/$defs/Identifier"},"process":{"$ref":"#/$defs/ProcessIdentity"}},"required":["protocolMajor","protocolMinor","sessionId","token","process"],"additionalProperties":false},
    "HelloResult": {"type":"object","properties":{"agentVersion":{"$ref":"#/$defs/Identifier"},"tfm":{"enum":["net48","net8.0-windows","net10.0-windows"]},"architecture":{"enum":["x86","x64"]},"runtimeVersion":{"$ref":"#/$defs/Identifier"},"features":{"$ref":"#/$defs/Features"},"process":{"$ref":"#/$defs/ProcessIdentity"}},"required":["agentVersion","tfm","architecture","runtimeVersion","features","process"],"additionalProperties":false},
    "ResolveParams": {"type":"object","properties":{"runtimeId":{"$ref":"#/$defs/RuntimeId"},"nativeWindowHandle":{"type":"integer"}},"required":["runtimeId"],"additionalProperties":false},
    "ReadBatchParams": {"type":"object","properties":{"candidates":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/CandidateRequest"}},"paths":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/Path"}}},"required":["candidates","paths"],"additionalProperties":false},
    "RootsParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"$ref":"#/$defs/Identifier"}},"required":["sessionId"],"additionalProperties":false},
    "ChildrenParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectId":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"tree":{"enum":["visual","logical"]},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"$ref":"#/$defs/Identifier"}},"required":["sessionId","objectId","generation","tree"],"additionalProperties":false},
    "MembersParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectId":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"$ref":"#/$defs/Identifier"}},"required":["sessionId","objectId","generation"],"additionalProperties":false},
    "ReadParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectId":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"paths":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/Path"}}},"required":["sessionId","objectId","generation","paths"],"additionalProperties":false},
    "BindingsParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectId":{"$ref":"#/$defs/Identifier"},"generation":{"type":"integer","minimum":1},"memberKeys":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/Key"}}},"required":["sessionId","objectId","generation","memberKeys"],"additionalProperties":false},
    "BindingsResult": {"type":"object","properties":{"bindings":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/BindingInfo"}}},"required":["bindings"],"additionalProperties":false},
    "ReleaseParams": {"type":"object","properties":{"sessionId":{"$ref":"#/$defs/Identifier"},"objectIds":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/Identifier"}}},"required":["sessionId","objectIds"],"additionalProperties":false},
    "ReleaseResult": {"type":"object","properties":{"releasedCount":{"type":"integer","minimum":0,"maximum":256}},"required":["releasedCount"],"additionalProperties":false},
    "CancelParams": {"type":"object","properties":{"requestId":{"type":"integer","minimum":1}},"required":["requestId"],"additionalProperties":false},
    "CancelResult": {"type":"object","properties":{"accepted":{"type":"boolean"}},"required":["accepted"],"additionalProperties":false},
    "CloseParams": {"type":"object","properties":{},"additionalProperties":false},
    "CloseResult": {"type":"object","properties":{"closed":{"const":true}},"required":["closed"],"additionalProperties":false},
    "BootstrapSettings": {"type":"object","properties":{"schemaVersion":{"const":1},"protocolMajor":{"type":"integer","minimum":0,"maximum":2147483647},"protocolMinor":{"type":"integer","minimum":0,"maximum":2147483647},"sessionId":{"type":"string","format":"uuid","maxLength":128},"process":{"$ref":"#/$defs/ProcessIdentity"},"pipeName":{"$ref":"#/$defs/Key"},"token":{"type":"string","pattern":"^[A-Za-z0-9+/]{43}=$"},"clientSid":{"$ref":"#/$defs/Identifier"},"expiresUtc":{"type":"string","format":"date-time","maxLength":128},"requestTimeoutMs":{"type":"integer","minimum":1,"maximum":2000},"idleTimeoutMs":{"type":"integer","minimum":1,"maximum":300000},"agentVersion":{"$ref":"#/$defs/Identifier"},"redactNames":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[^\\uD800-\\uDFFF]*$"}}},"required":["schemaVersion","protocolMajor","protocolMinor","sessionId","process","pipeName","token","clientSid","expiresUtc","requestTimeoutMs","idleTimeoutMs","agentVersion","redactNames"],"additionalProperties":false}
  }
}

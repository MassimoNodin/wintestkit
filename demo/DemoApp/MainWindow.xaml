<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTK Demo" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="File">
        <MenuItem Header="Reset" Click="Reset_Click" />
        <MenuItem Header="Exit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About" Click="About_Click" />
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" Text="Ready" AutomationProperties.AutomationId="StatusText" />
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="8">
        <GroupBox Header="Credentials">
          <StackPanel Margin="8">
            <TextBlock Text="Username" />
            <TextBox Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="Password" />
            <PasswordBox Width="200" HorizontalAlignment="Left" />
            <CheckBox Content="Remember me" Margin="0,8,0,8"
                      Checked="RememberMe_Changed" Unchecked="RememberMe_Changed" />
            <Button Content="Sign in" HorizontalAlignment="Left" Padding="12,4" Click="SignIn_Click" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Panel A" Margin="0,8,0,0">
          <Button Content="OK" HorizontalAlignment="Left" Margin="8" Padding="12,4" Click="PanelA_Click" />
        </GroupBox>
        <GroupBox Header="Panel B" Margin="0,8,0,0">
          <Button Content="OK" HorizontalAlignment="Left" Margin="8" Padding="12,4" Click="PanelB_Click" />
        </GroupBox>
        <GroupBox Header="Async" Margin="0,8,0,0">
          <StackPanel Margin="8">
            <Button Content="Load" HorizontalAlignment="Left" Padding="12,4" Click="Load_Click" />
            <TextBlock Text="Data loaded" Visibility="Collapsed" Margin="0,4,0,4" />
            <Button Content="Continue" IsEnabled="False" HorizontalAlignment="Left" Padding="12,4" Click="Continue_Click" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Choices" Margin="0,8,0,0">
          <ComboBox x:Name="ColorCombo" Width="150" HorizontalAlignment="Left" Margin="8"
                    AutomationProperties.AutomationId="ColorCombo" SelectionChanged="Color_SelectionChanged" />
        </GroupBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Open dialog" Padding="12,4" Click="OpenDialog_Click" />
          <Button Content="Show message" Padding="12,4" Margin="8,0,0,0" Click="ShowMessage_Click" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8">
        <TextBlock Text="Items" />
        <ListBox Height="180" SelectionChanged="Items_SelectionChanged" />
        <TextBlock Text="Products" Margin="0,8,0,0" />
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" Height="260"
                  SelectionMode="Single" SelectionChanged="Products_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>

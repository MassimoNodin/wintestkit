<Window x:Class="DemoApp.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTK Demo - Dialog" Width="360" Height="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Text="Enter a note:" />
    <TextBox Margin="0,8,0,8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save" IsDefault="True" Padding="12,4" Click="Save_Click" />
      <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>

{
  "name": "wintestkit",
  "publisher": "wintestkit",
  "displayName": "WinTestKit",
  "description": "UI test automation for Windows WPF apps — highlight elements, run tests, inspect UI.",
  "version": "0.1.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/pyproject.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wintestkit.tests.run",
        "title": "Run Tests",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.tests.debug",
        "title": "Debug Tests",
        "category": "WinTestKit",
        "icon": "$(debug-alt)"
      },
      {
        "command": "wintestkit.highlightElement",
        "title": "Highlight Element",
        "category": "WinTestKit",
        "icon": "$(eye)"
      },
      {
        "command": "wintestkit.checkElement",
        "title": "Check Element",
        "category": "WinTestKit",
        "icon": "$(check)"
      },
      {
        "command": "wintestkit.checkPage",
        "title": "Check All Elements",
        "category": "WinTestKit",
        "icon": "$(checklist)"
      },
      {
        "command": "wintestkit.runTest",
        "title": "Run Test",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.debugTest",
        "title": "Debug Test",
        "category": "WinTestKit",
        "icon": "$(debug-alt)"
      },
      {
        "command": "wintestkit.launchApp",
        "title": "Launch App",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.closeApp",
        "title": "Close App",
        "category": "WinTestKit",
        "icon": "$(debug-stop)"
      },
      {
        "command": "wintestkit.restartApp",
        "title": "Restart App",
        "category": "WinTestKit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "wintestkit.refreshApp",
        "title": "Refresh App Status",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.restartServer",
        "title": "Restart Server",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.showOutput",
        "title": "Show Output",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openReport",
        "title": "Open Last Report",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.runDoctor",
        "title": "Check Environment (doctor)",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.initProject",
        "title": "Initialize Project",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.installPackage",
        "title": "Install wintestkit Package",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.spy.startPick",
        "title": "Pick Element",
        "category": "WinTestKit",
        "icon": "$(inspect)"
      },
      {
        "command": "wintestkit.spy.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.elements.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.elements.goTo",
        "title": "Go to Definition",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openSettings",
        "title": "Open Configuration",
        "category": "WinTestKit",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wintestkit",
          "title": "WinTestKit",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "wintestkit": [
        {
          "id": "wintestkit.setup",
          "name": "Current Setup"
        },
        {
          "id": "wintestkit.navigation",
          "name": "Explorer",
          "type": "webview"
        },
        {
          "id": "wintestkit.spy",
          "name": "Spy",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wintestkit.setup",
        "contents": "[Initialize Project](command:wintestkit.initProject)",
        "when": "!wintestkit.hasProject"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wintestkit.openSettings",
          "when": "view == wintestkit.setup",
          "group": "navigation"
        },
        {
          "command": "wintestkit.elements.refresh",
          "when": "view == wintestkit.navigation",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wintestkit.launchApp",
          "when": "view == wintestkit.setup && isWorkspaceTrusted && viewItem == current-setup-stopped-launchable",
          "group": "inline@1"
        },
        {
          "command": "wintestkit.closeApp",
          "when": "view == wintestkit.setup && isWorkspaceTrusted && viewItem =~ /^current-setup-running-/",
          "group": "inline@1"
        },
        {
          "command": "wintestkit.restartApp",
          "when": "view == wintestkit.setup && isWorkspaceTrusted && viewItem == current-setup-running-launchable",
          "group": "inline@2"
        },
        {
          "command": "wintestkit.refreshApp",
          "when": "view == wintestkit.setup && isWorkspaceTrusted && viewItem =~ /^current-setup/",
          "group": "inline@3"
        },
        {
          "command": "wintestkit.openSettings",
          "when": "view == wintestkit.setup && viewItem =~ /^current-setup/",
          "group": "inline@4"
        }
      ],
      "webview/context": [
        {
          "command": "wintestkit.highlightElement",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection =~ /^(element|window)$/",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection == element",
          "group": "navigation@2"
        },
        {
          "command": "wintestkit.checkPage",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection == page",
          "group": "navigation@3"
        },
        {
          "command": "wintestkit.tests.run",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection =~ /^test(-class|-file|-project)?$/",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.tests.debug",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection =~ /^test(-class|-file|-project)?$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "wintestkit.tests.run",
          "when": "false"
        },
        {
          "command": "wintestkit.tests.debug",
          "when": "false"
        },
        {
          "command": "wintestkit.highlightElement",
          "when": "false"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "false"
        },
        {
          "command": "wintestkit.runTest",
          "when": "false"
        },
        {
          "command": "wintestkit.debugTest",
          "when": "false"
        },
        {
          "command": "wintestkit.elements.goTo",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "wintestkit.openSettings",
          "when": "resourceFilename == wintestkit.yaml || resourceFilename == wintestkit.local.yaml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WinTestKit",
      "properties": {
        "wintestkit.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to use. Empty = the Python extension's selected interpreter."
        },
        "wintestkit.codeLens.enabled": {
          "type": "boolean",
          "default": true
        },
        "wintestkit.highlight.durationMs": {
          "type": "number",
          "default": 1500,
          "minimum": 200,
          "maximum": 10000
        },
        "wintestkit.run.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `wtk run`."
        },
        "wintestkit.run.highlightActions": {
          "type": "boolean",
          "default": false,
          "description": "Flash each element before acting during runs from VS Code."
        },
        "wintestkit.server.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "info"
        },
        "wintestkit.promptDisablePytestExplorer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "customEditors": [
      {
        "viewType": "wintestkit.configuration",
        "displayName": "WinTestKit Configuration",
        "selector": [
          {
            "filenamePattern": "**/wintestkit.yaml"
          },
          {
            "filenamePattern": "**/wintestkit.local.yaml"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MassimoNodin/wintestkit.git"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit && tsc -p test/tsconfig.unit.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "tsc -p test && node ./out/test/integration/runTest.js",
    "package": "npm run build && vsce package --target win32-x64 -o dist/",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "mocha": "^11.0.0",
    "ovsx": "^1.2.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}

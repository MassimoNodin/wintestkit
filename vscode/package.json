{
  "name": "wintestkit",
  "publisher": "wintestkit",
  "displayName": "WinTestKit",
  "description": "UI test automation for Windows WPF apps — highlight elements, run tests, inspect UI.",
  "version": "0.1.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/pyproject.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wintestkit.highlightElement",
        "title": "Highlight Element",
        "category": "WinTestKit",
        "icon": "$(eye)"
      },
      {
        "command": "wintestkit.checkElement",
        "title": "Check exists",
        "category": "WinTestKit",
        "icon": "$(check)"
      },
      {
        "command": "wintestkit.checkPage",
        "title": "Check all elements in this class exist",
        "category": "WinTestKit",
        "icon": "$(checklist)"
      },
      {
        "command": "wintestkit.runFlow",
        "title": "Run Flow",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.checkAfterFlow",
        "title": "Check after flow",
        "category": "WinTestKit",
        "icon": "$(debug-start)"
      },
      {
        "command": "wintestkit.sweepProject",
        "title": "Sweep project using remembered reach flows",
        "category": "WinTestKit",
        "icon": "$(run-all)"
      },
      {
        "command": "wintestkit.launchApp",
        "title": "Launch App",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.closeApp",
        "title": "Close App",
        "category": "WinTestKit",
        "icon": "$(debug-stop)"
      },
      {
        "command": "wintestkit.restartApp",
        "title": "Restart App",
        "category": "WinTestKit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "wintestkit.refreshApp",
        "title": "Refresh App Status",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.restartServer",
        "title": "Restart Server",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.showOutput",
        "title": "Show Output",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openTesting",
        "title": "Open Testing",
        "category": "WinTestKit",
        "icon": "$(beaker)"
      },
      {
        "command": "wintestkit.chooseApp",
        "title": "Choose App",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openGettingStarted",
        "title": "Open Getting Started",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openReport",
        "title": "Open Last Report",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.exportReport",
        "title": "Export Last Report as HTML",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openPreviousReport",
        "title": "Open Report from a Previous Run…",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openRunReport",
        "title": "Open Test Report for This Run",
        "category": "WinTestKit",
        "icon": "$(link-external)"
      },
      {
        "command": "wintestkit.openTestReport",
        "title": "Open in Report",
        "category": "WinTestKit",
        "icon": "$(link-external)"
      },
      {
        "command": "wintestkit.runDoctor",
        "title": "Check Environment (doctor)",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.initProject",
        "title": "Initialize Project",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.installPackage",
        "title": "Install wintestkit Package",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.spy.startPick",
        "title": "Pick Element",
        "category": "WinTestKit",
        "icon": "$(inspect)"
      },
      {
        "command": "wintestkit.spy.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.spy.revealRelocation",
        "title": "Reveal Relocated Element in Spy",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.elements.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.elements.goTo",
        "title": "Go to Definition",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openSettings",
        "title": "Open Configuration",
        "category": "WinTestKit",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wintestkit",
          "title": "WinTestKit",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "wintestkit": [
        {
          "id": "wintestkit.setup",
          "name": "Test Target",
          "type": "webview"
        },
        {
          "id": "wintestkit.navigation",
          "name": "Pages & Flows",
          "type": "webview"
        },
        {
          "id": "wintestkit.spy",
          "name": "Spy",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "wintestkit.firstRun",
        "title": "Get started with WinTestKit",
        "description": "Choose a target, inspect it, and run your first test.",
        "steps": [
          { "id": "chooseApp", "title": "Choose an application", "description": "Use the app chooser in Test Target.", "media": { "markdown": "media/walkthrough/choose-app.md" }, "completionEvents": ["onContext:wintestkit.hasChosenApp"] },
          { "id": "launchApp", "title": "Launch the application", "description": "Start the target so Spy can inspect its controls.", "media": { "markdown": "media/walkthrough/launch-app.md" }, "completionEvents": ["onCommand:wintestkit.launchApp"] },
          { "id": "addControl", "title": "Add a control to a page", "description": "Pick a live control in Spy and add its locator to your page definitions.", "media": { "markdown": "media/walkthrough/add-control.md" }, "completionEvents": ["onCommand:wintestkit.spy.addToPage"] },
          { "id": "checkElement", "title": "Check the locator", "description": "Confirm the page element resolves in the running application.", "media": { "markdown": "media/walkthrough/check-element.md" }, "completionEvents": ["onCommand:wintestkit.checkElement"] },
          { "id": "runSmokeTest", "title": "Run tests", "description": "Open Testing and run the smoke test.", "media": { "markdown": "media/walkthrough/run-tests.md" }, "completionEvents": ["onCommand:testing.runAll"] }
        ]
      }
    ],
    "viewsWelcome": [
      { "view": "wintestkit.navigation", "contents": "No WinTestKit project is initialized. [Initialize Project](command:wintestkit.initProject)" },
      { "view": "wintestkit.spy", "contents": "Choose an application in [Test Target](command:wintestkit.openSettings), then launch it to inspect live controls." }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wintestkit.openTesting",
          "when": "view == wintestkit.navigation",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.openSettings",
          "when": "view == wintestkit.setup",
          "group": "navigation"
        },
        {
          "command": "wintestkit.elements.refresh",
          "when": "view == wintestkit.navigation",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "wintestkit.highlightElement",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection =~ /^(element|window)$/",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection =~ /^(element|window)$/",
          "group": "navigation@2"
        },
        {
          "command": "wintestkit.checkPage",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection == page",
          "group": "navigation@3"
        },
        {
          "command": "wintestkit.runFlow",
          "when": "webviewId == 'wintestkit.navigation' && webviewSection == flow && flowName",
          "group": "navigation@4"
        }
      ],
      "testing/message/context": [
        {
          "command": "wintestkit.openRunReport",
          "when": "testMessage =~ /^wintestkit.run:/",
          "group": "inline@9"
        }
      ],
      "testing/item/context": [
        {
          "command": "wintestkit.openTestReport",
          "when": "controllerId == wintestkit && testing.testItemHasUri && testId in wintestkit.reportTestIds",
          "group": "inline@9"
        }
      ],
      "testing/item/result": [
        {
          "command": "wintestkit.openRunReport",
          "when": "controllerId == wintestkit && peekItemType == test",
          "group": "inline@9"
        }
      ],
      "commandPalette": [
        {
          "command": "wintestkit.openTestReport",
          "when": "false"
        },
        {
          "command": "wintestkit.openRunReport",
          "when": "false"
        },
        {
          "command": "wintestkit.highlightElement",
          "when": "false"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "false"
        },
        {
          "command": "wintestkit.elements.goTo",
          "when": "false"
        },
        {
          "command": "wintestkit.runFlow",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "wintestkit.openSettings",
          "when": "resourceFilename == wintestkit.yaml || resourceFilename == wintestkit.local.yaml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WinTestKit",
      "properties": {
        "wintestkit.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to use. Empty = the Python extension's selected interpreter."
        },
        "wintestkit.codeLens.enabled": {
          "type": "boolean",
          "default": true
        },
        "wintestkit.codeLens.classOnly": {
          "type": "boolean",
          "default": false,
          "description": "Show only the class check lens. Element highlight and check lenses are hidden; Page Tree controls remain available."
        },
        "wintestkit.spy.bringWindowToFront": {
          "type": "boolean",
          "default": false,
          "description": "Bring an application's window to the front (without taking focus from VS Code) when you select or highlight one of its objects in Spy. The outline is drawn above every window either way."
        },
        "wintestkit.keepRunReports": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "How many runs started from the Testing view keep their own report. VS Code's Test Results buttons open these; the oldest are deleted beyond this number, and a run's report is also deleted when VS Code clears that run."
        },
        "wintestkit.openReportOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "Open the HTML report straight away in the main editor area when a test run has failures. When off, a notification offers to open it."
        },
        "wintestkit.spy.markDefinedObjects": {
          "type": "boolean",
          "default": true,
          "description": "Mark objects in the Spy tree that an element definition in your pages already points at. Turn off if the application is slow to answer UI Automation queries."
        },
        "wintestkit.highlight.durationMs": {
          "type": "number",
          "default": 1500,
          "minimum": 200,
          "maximum": 10000
        },
        "wintestkit.run.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `wtk run`."
        },
        "wintestkit.run.highlightActions": {
          "type": "boolean",
          "default": false,
          "description": "Flash each element before acting during runs from VS Code."
        },
        "wintestkit.server.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "info"
        },
        "wintestkit.promptDisablePytestExplorer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "customEditors": [
      {
        "viewType": "wintestkit.configuration",
        "displayName": "WinTestKit Configuration",
        "selector": [
          {
            "filenamePattern": "**/wintestkit.yaml"
          },
          {
            "filenamePattern": "**/wintestkit.local.yaml"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MassimoNodin/wintestkit.git"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit && tsc -p test/tsconfig.unit.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "tsc -p test && node ./out/test/integration/runTest.js",
    "package": "npm run build && vsce package --target win32-x64 -o dist/",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "mocha": "^11.0.0",
    "ovsx": "^1.2.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}

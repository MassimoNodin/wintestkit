{
  "name": "wintestkit",
  "publisher": "wintestkit",
  "displayName": "WinTestKit",
  "description": "UI test automation for Windows WPF apps — highlight elements, run tests, inspect UI.",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MassimoNodin/wintestkit.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/MassimoNodin/wintestkit/issues"
  },
  "homepage": "https://github.com/MassimoNodin/wintestkit#readme",
  "keywords": [
    "wpf",
    "ui automation",
    "windows",
    "testing",
    "pytest"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/pyproject.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wintestkit.highlightElement",
        "title": "Highlight Element",
        "category": "WinTestKit",
        "icon": "$(eye)"
      },
      {
        "command": "wintestkit.checkElement",
        "title": "Check exists",
        "category": "WinTestKit",
        "icon": "$(check)"
      },
      {
        "command": "wintestkit.checkPage",
        "title": "Check all elements in this class exist",
        "category": "WinTestKit",
        "icon": "$(checklist)"
      },
      {
        "command": "wintestkit.runFlow",
        "title": "Run Flow",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.checkAfterFlow",
        "title": "Check after flow",
        "category": "WinTestKit",
        "icon": "$(debug-start)"
      },
      {
        "command": "wintestkit.sweepProject",
        "title": "Sweep project using remembered reach flows",
        "category": "WinTestKit",
        "icon": "$(run-all)"
      },
      {
        "command": "wintestkit.launchApp",
        "title": "Launch App",
        "category": "WinTestKit",
        "icon": "$(play)"
      },
      {
        "command": "wintestkit.closeApp",
        "title": "Close App",
        "category": "WinTestKit",
        "icon": "$(debug-stop)"
      },
      {
        "command": "wintestkit.restartApp",
        "title": "Restart App",
        "category": "WinTestKit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "wintestkit.refreshApp",
        "title": "Refresh App Status",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.restartServer",
        "title": "Restart Server",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.installCompatiblePackage",
        "title": "Install Compatible Python Package",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.selectInterpreter",
        "title": "Choose Python Interpreter",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.updateExtension",
        "title": "Check Extension Updates",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.showOutput",
        "title": "Show Output",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openTesting",
        "title": "Open Testing",
        "category": "WinTestKit",
        "icon": "$(beaker)"
      },
      {
        "command": "wintestkit.chooseApp",
        "title": "Choose App",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openSetup",
        "title": "Open Setup Guide",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.enable",
        "title": "Enable for This Workspace",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.disable",
        "title": "Disable for This Workspace",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.setup.recheck",
        "title": "Check Setup",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openReport",
        "title": "Open Last Report",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.exportReport",
        "title": "Export Last Report as HTML",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openPreviousReport",
        "title": "Open Report from a Previous Run…",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openRunReport",
        "title": "Open Test Report for This Run",
        "category": "WinTestKit",
        "icon": "$(link-external)"
      },
      {
        "command": "wintestkit.openTestReport",
        "title": "Open in Report",
        "category": "WinTestKit",
        "icon": "$(link-external)"
      },
      {
        "command": "wintestkit.runDoctor",
        "title": "Check Environment (doctor)",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.spy.startPick",
        "title": "Pick Element",
        "category": "WinTestKit",
        "icon": "$(inspect)"
      },
      {
        "command": "wintestkit.spy.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.spy.revealRelocation",
        "title": "Reveal Relocated Element in Spy",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.elements.refresh",
        "title": "Refresh",
        "category": "WinTestKit",
        "icon": "$(refresh)"
      },
      {
        "command": "wintestkit.elements.goTo",
        "title": "Go to Definition",
        "category": "WinTestKit"
      },
      {
        "command": "wintestkit.openSettings",
        "title": "Open Configuration",
        "category": "WinTestKit",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wintestkit",
          "title": "WinTestKit",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "wintestkit-spy",
          "title": "WinTestKit Spy",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "wintestkit": [
        {
          "id": "wintestkit.sidebar",
          "name": "WinTestKit",
          "type": "webview"
        }
      ],
      "wintestkit-spy": [
        {
          "id": "wintestkit.spy",
          "name": "Spy",
          "type": "webview",
          "when": "wintestkit.enabled && !wintestkit.setupBlocked"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wintestkit.openTesting",
          "when": "view == wintestkit.sidebar && wintestkit.enabled && !wintestkit.setupBlocked",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.openSettings",
          "when": "view == wintestkit.sidebar && wintestkit.enabled && !wintestkit.setupBlocked",
          "group": "navigation@3"
        },
        {
          "command": "wintestkit.elements.refresh",
          "when": "view == wintestkit.sidebar && wintestkit.enabled && !wintestkit.setupBlocked",
          "group": "navigation@2"
        },
        {
          "command": "wintestkit.disable",
          "when": "view == wintestkit.sidebar && wintestkit.enabled",
          "group": "9_wintestkit"
        }
      ],
      "webview/context": [
        {
          "command": "wintestkit.highlightElement",
          "when": "webviewId == 'wintestkit.sidebar' && webviewSection =~ /^(element|window)$/",
          "group": "navigation@1"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "webviewId == 'wintestkit.sidebar' && webviewSection =~ /^(element|window)$/",
          "group": "navigation@2"
        },
        {
          "command": "wintestkit.checkPage",
          "when": "webviewId == 'wintestkit.sidebar' && webviewSection == page",
          "group": "navigation@3"
        },
        {
          "command": "wintestkit.runFlow",
          "when": "webviewId == 'wintestkit.sidebar' && webviewSection == flow && flowName",
          "group": "navigation@4"
        }
      ],
      "testing/message/context": [
        {
          "command": "wintestkit.openRunReport",
          "when": "testMessage =~ /^wintestkit.run:/",
          "group": "inline@9"
        }
      ],
      "testing/item/context": [
        {
          "command": "wintestkit.openTestReport",
          "when": "controllerId == wintestkit && testing.testItemHasUri && testId in wintestkit.reportTestIds",
          "group": "inline@9"
        }
      ],
      "testing/item/result": [
        {
          "command": "wintestkit.openRunReport",
          "when": "controllerId == wintestkit && peekItemType == test",
          "group": "inline@9"
        }
      ],
      "commandPalette": [
        {
          "command": "wintestkit.openTestReport",
          "when": "false"
        },
        {
          "command": "wintestkit.openRunReport",
          "when": "false"
        },
        {
          "command": "wintestkit.highlightElement",
          "when": "false"
        },
        {
          "command": "wintestkit.checkElement",
          "when": "false"
        },
        {
          "command": "wintestkit.elements.goTo",
          "when": "false"
        },
        {
          "command": "wintestkit.runFlow",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "wintestkit.openSettings",
          "when": "resourceFilename == wintestkit.yaml || resourceFilename == wintestkit.local.yaml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "WinTestKit",
      "properties": {
        "wintestkit.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to use. Empty = the Python extension's selected interpreter."
        },
        "wintestkit.codeLens.enabled": {
          "type": "boolean",
          "default": true
        },
        "wintestkit.codeLens.classOnly": {
          "type": "boolean",
          "default": false,
          "description": "Show only the class check lens. Element highlight and check lenses are hidden; Page Tree controls remain available."
        },
        "wintestkit.spy.bringWindowToFront": {
          "type": "boolean",
          "default": false,
          "description": "Bring an application's window to the front (without taking focus from VS Code) when you highlight one of its objects in Spy. Selecting an object only inspects it. The outline is drawn above every window either way."
        },
        "wintestkit.keepRunReports": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "How many runs started from the Testing view keep their own report. VS Code's Test Results buttons open these; the oldest are deleted beyond this number, and a run's report is also deleted when VS Code clears that run."
        },
        "wintestkit.openReportOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "Open the HTML report straight away in the main editor area when a test run has failures. When off, a notification offers to open it."
        },
        "wintestkit.spy.markDefinedObjects": {
          "type": "boolean",
          "default": true,
          "description": "Mark objects in the Spy tree that an element definition in your pages already points at. Turn off if the application is slow to answer UI Automation queries."
        },
        "wintestkit.highlight.durationMs": {
          "type": "number",
          "default": 1500,
          "minimum": 200,
          "maximum": 10000
        },
        "wintestkit.run.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `wtk run`."
        },
        "wintestkit.run.highlightActions": {
          "type": "boolean",
          "default": false,
          "description": "Flash each element before acting during runs from VS Code."
        },
        "wintestkit.server.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "default": "info"
        },
        "wintestkit.promptDisablePytestExplorer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "customEditors": [
      {
        "viewType": "wintestkit.configuration",
        "displayName": "WinTestKit Configuration",
        "selector": [
          {
            "filenamePattern": "**/wintestkit.yaml"
          },
          {
            "filenamePattern": "**/wintestkit.local.yaml"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MassimoNodin/wintestkit.git"
  },
  "homepage": "https://github.com/MassimoNodin/wintestkit#readme",
  "bugs": {
    "url": "https://github.com/MassimoNodin/wintestkit/issues"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch:dev": "node esbuild.mjs --dev --watch",
    "package:dev": "node scripts/package-dev.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit && tsc -p test/tsconfig.unit.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "tsc -p test && node ./out/test/integration/runTest.js",
    "package": "npm run build && node scripts/package.mjs",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}

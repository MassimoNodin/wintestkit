{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wintestkit.dev/schemas/step.schema.json",
  "$ref": "#/$defs/StepEvent",
  "$defs": {
    "StepEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "start": {
          "type": "number"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "backend": {
          "type": "string",
          "enum": [
            "uia",
            "wpf"
          ]
        },
        "audits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "setProperty",
                  "call"
                ]
              },
              "typeFullName": {
                "type": "string"
              },
              "memberKey": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "performed",
                  "denied",
                  "failed"
                ]
              },
              "timestampUtc": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string"
              },
              "authorization": {
                "enum": [
                  "allowlist",
                  "pure"
                ]
              }
            },
            "required": [
              "operation",
              "typeFullName",
              "memberKey",
              "outcome",
              "timestampUtc"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "$ref": "common.schema.json#/$defs/ErrorInfo"
        },
        "screenshot": {
          "type": "string"
        },
        "parent": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "seq",
        "action",
        "target",
        "locator",
        "args",
        "start",
        "duration",
        "status"
      ],
      "additionalProperties": false
    }
  }
}

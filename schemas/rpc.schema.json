{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wintestkit.dev/schemas/rpc.schema.json",
  "$defs": {
    "CancelRequestNotification": {"type":"object","properties":{"id":{"type":["integer","string"]}},"required":["id"],"additionalProperties":false},
    "InspectManagedIdentifyParams": {"type":"object","properties":{"nodeId":{"type":"string","minLength":1}},"required":["nodeId"],"additionalProperties":false},
    "InspectManagedIdentifyResult": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"},"executable":{"type":"string"},"runtime":{"enum":["net48","net8","net10",null]},"architecture":{"enum":["x86","x64","arm64","unknown"]},"wpfLoaded":{"type":"boolean"},"winformsLoaded":{"type":"boolean"},"appUnderTest":{"type":"boolean"}},"required":["process","executable","runtime","architecture","wpfLoaded","winformsLoaded","appUnderTest"],"additionalProperties":false},
    "InspectManagedAttachParams": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"},"hostCapability":{"$ref":"#/$defs/SpyHostCapability"}},"required":["process"],"additionalProperties":false},
    "InspectManagedAttachResult": {"$ref":"common.schema.json#/$defs/ManagedSession"},
    "InspectManagedStatusParams": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"}},"required":["process"],"additionalProperties":false},
    "InspectManagedStatusResult": {"$ref":"common.schema.json#/$defs/ManagedSession"},
    "InspectManagedDetachParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId"],"additionalProperties":false},
    "InspectManagedDetachResult": {"type":"object","properties":{"detached":{"const":true}},"required":["detached"],"additionalProperties":false},
    "InspectManagedKeepaliveParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId"],"additionalProperties":false},
    "InspectManagedKeepaliveResult": {"type":"object","properties":{"alive":{"const":true}},"required":["alive"],"additionalProperties":false},
    "InspectManagedResolveParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"nodeId":{"type":"string","minLength":1}},"required":["sessionId","nodeId"],"additionalProperties":false},
    "InspectManagedResolveResult": {"anyOf":[{"$ref":"common.schema.json#/$defs/ManagedMapping"},{"type":"object","properties":{"status":{"const":"exact"},"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"},"object":{"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/ObjectRef"},"source":{"enum":["wpf","winforms"]}},"required":["status","process","object","source"],"additionalProperties":false}]},
    "SpyHostCapability": {"type":"string","pattern":"^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$","minLength":44,"maxLength":44},
    "SpyInvokeArgument": {"type":"object","properties":{"type":{"type":"string","minLength":1,"maxLength":1024},"value":{"anyOf":[{"type":"string","maxLength":4096},{"type":"boolean"},{"type":"number"}]},"enum":{"anyOf":[{"type":"string","maxLength":4096},{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807}]},"null":{"const":true}},"required":["type"],"oneOf":[{"required":["value"]},{"required":["enum"]},{"required":["null"]}],"additionalProperties":false},
    "InspectManagedSpySelectParams": {"type":"object","properties":{"hostCapability":{"$ref":"#/$defs/SpyHostCapability"},"sessionId":{"type":"string","minLength":1,"maxLength":128},"nodeId":{"type":"string","minLength":1}},"required":["hostCapability"],"dependentRequired":{"sessionId":["nodeId"],"nodeId":["sessionId"]},"additionalProperties":false},
    "InspectManagedSpySelectResult": {"type":"object","properties":{"canInvoke":{"type":"boolean"},"mapping":{"$ref":"#/$defs/InspectManagedResolveResult"}},"required":["canInvoke"],"additionalProperties":false},
    "InspectManagedSpyPrepareInvokeParams": {"type":"object","properties":{"hostCapability":{"$ref":"#/$defs/SpyHostCapability"},"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"memberKey":{"type":"string","minLength":1,"maxLength":8192},"arguments":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/SpyInvokeArgument"}}},"required":["hostCapability","sessionId","objectId","generation","memberKey","arguments"],"additionalProperties":false},
    "InspectManagedSpyPrepareInvokeResult": {"type":"object","properties":{"ticket":{"type":"string","minLength":1,"maxLength":128}},"required":["ticket"],"additionalProperties":false},
    "InspectManagedSpyInvokeParams": {"type":"object","properties":{"hostCapability":{"$ref":"#/$defs/SpyHostCapability"},"ticket":{"type":"string","minLength":1,"maxLength":128}},"required":["hostCapability","ticket"],"additionalProperties":false},
    "InspectManagedSpyInvokeResult": {"type":"object","properties":{"audit":{"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/WriteAudit"},"result":{"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/Value"}},"required":["audit","result"],"additionalProperties":false},
    "InspectManagedRootsParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId"],"additionalProperties":false},
    "InspectManagedRootsResult": {"$ref":"common.schema.json#/$defs/ManagedInspectorNodePage"},
    "InspectManagedChildrenParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"tree":{"enum":["visual","logical"]},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId","objectId","generation","tree"],"additionalProperties":false},
    "InspectManagedChildrenResult": {"$ref":"common.schema.json#/$defs/ManagedInspectorNodePage"},
    "InspectManagedMembersParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId","objectId","generation"],"additionalProperties":false},
    "InspectManagedMembersResult": {"$ref":"common.schema.json#/$defs/ManagedMemberPage"},
    "InspectManagedItemsParams": {"$ref":"#/$defs/InspectManagedMembersParams"},
    "InspectManagedItemsResult": {"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/ItemsResult"},
    "InspectManagedStylingParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1}},"required":["sessionId","objectId","generation"],"additionalProperties":false},
    "InspectManagedStylingResult": {"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/StylingResult"},
    "InspectManagedResourceParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"scope":{"enum":["local","application"]},"key":{"type":"string","maxLength":1024},"keyKind":{"enum":["string","type","componentResourceKey","other"]},"index":{"type":"integer","minimum":0,"maximum":2147483647}},"required":["sessionId","objectId","generation","scope","key","keyKind"],"additionalProperties":false},
    "InspectManagedResourceResult": {"$ref":"../wpf-inspector/protocol/inspector.schema.json#/$defs/ResourceResult"},
    "InspectManagedEventsParams": {"$ref":"#/$defs/InspectManagedMembersParams"},
    "InspectManagedEventsResult": {"$ref":"common.schema.json#/$defs/ManagedEventPage"},
    "InspectManagedSpyMethodsParams": {"$ref":"#/$defs/InspectManagedMembersParams"},
    "InspectManagedSpyMethodsResult": {"$ref":"common.schema.json#/$defs/ManagedMethodPage"},
    "InspectManagedReadParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"paths":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedPath"}}},"required":["sessionId","objectId","generation","paths"],"additionalProperties":false},
    "InspectManagedReadResult": {"type":"object","properties":{"values":{"type":"array","maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedPathValue"}},"readId":{"type":"string","minLength":1,"maxLength":128}},"required":["values","readId"],"additionalProperties":false},
    "InspectManagedBindingsParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"memberKeys":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":1024}}},"required":["sessionId","objectId","generation","memberKeys"],"additionalProperties":false},
    "InspectManagedBindingsResult": {"type":"object","properties":{"bindings":{"type":"array","maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedBindingInfo"}}},"required":["bindings"],"additionalProperties":false},
    "InspectManagedReleaseParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectIds":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"string","minLength":1,"maxLength":128}}},"required":["sessionId","objectIds"],"additionalProperties":false},
    "InspectManagedReleaseResult": {"type":"object","properties":{"releasedCount":{"type":"integer","minimum":0,"maximum":256}},"required":["releasedCount"],"additionalProperties":false},
    "ElementResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["found", "not_found", "ambiguous", "error", "not_responding"]
        },
        "element": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "diagnostic": {
          "$ref": "common.schema.json#/$defs/Diagnostic"
        },
        "message": {
          "type": "string"
        },
        "code": { "type": "string" },
        "hint": { "type": "string" },
        "outlinedAncestor": { "type": "string" },
        "outlinedTarget": { "type": "string" },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["status", "durationMs"],
      "additionalProperties": false
    },
    "NodeInfo": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "info": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "hasChildren": {
          "type": "boolean"
        },
        "source": {"enum": ["wpf", "winforms", "uia"]},
        "identity": {
          "type": "object",
          "properties": {"type": {"type": "string"}, "xName": {"type": "string"}, "automationId": {"type": "string"}, "siblingIndex": {"type": "integer", "minimum": 0}},
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "required": ["nodeId", "info", "hasChildren"],
      "additionalProperties": false
    },
    "Suggestion": {
      "type": "object",
      "properties": {
        "locator": {
          "$ref": "common.schema.json#/$defs/LocatorData"
        },
        "code": {
          "type": "string"
        },
        "attributeName": {
          "type": "string"
        },
        "helpers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attributeName": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "locator": {
                "$ref": "common.schema.json#/$defs/LocatorData"
              }
            },
            "required": ["attributeName", "code", "locator"],
            "additionalProperties": false
          }
        },
        "unique": {
          "type": "boolean"
        },
        "matchCount": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "string",
          "enum": ["automation_id", "name", "class_name", "within", "index"]
        },
        "window": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "locator": {
              "$ref": "common.schema.json#/$defs/WindowLocatorData"
            }
          },
          "required": ["code", "locator"],
          "additionalProperties": false
        }
      },
      "required": [
        "locator",
        "code",
        "attributeName",
        "helpers",
        "unique",
        "matchCount",
        "strategy"
      ],
      "additionalProperties": false
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["found", "not_found", "ambiguous", "error", "not_responding"]
        },
        "element": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "diagnostic": {
          "$ref": "common.schema.json#/$defs/Diagnostic"
        },
        "message": {
          "type": "string"
        },
        "code": { "type": "string" },
        "hint": { "type": "string" },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "qualname": {
          "type": "string"
        }
      },
      "required": ["status", "durationMs", "qualname"],
      "additionalProperties": false
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "wintestkitVersion": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {"managedInspector": {"type": "boolean"}},
          "required": ["managedInspector"],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "found": {
              "type": "boolean"
            },
            "app": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "process": {
                  "type": "string"
                }
              },
              "required": ["path", "process"],
              "additionalProperties": false
            },
            "launch": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reportDir": {
              "type": "string"
            }
          },
          "required": ["found", "launch", "timeout", "reportDir"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "wintestkitVersion", "python", "config"],
      "additionalProperties": false
    },
    "ShutdownParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ShutdownResult": {
      "type": "null"
    },
    "DiscoverParams": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "DiscoverResult": {
      "$ref": "discovery.schema.json#/$defs/DiscoveryResult"
    },
    "AppStatusParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppStatusResult": {
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "owned": {
          "type": "boolean",
          "description": "True only while the server still owns the exact PID set it launched."
        },
        "pids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mainWindowTitle": {
          "type": "string"
        }
      },
      "required": ["running", "pids", "owned"],
      "additionalProperties": false
    },
    "AppLaunchParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppProcessesParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "RunningProcess": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "pids": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "windowTitle": { "type": "string" }
      },
      "required": ["name", "pids", "windowTitle"],
      "additionalProperties": false
    },
    "AppProcessesResult": {
      "type": "object",
      "properties": {
        "processes": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/RunningProcess" }
        }
      },
      "required": ["processes"],
      "additionalProperties": false
    },
    "AppLaunchResult": {
      "type": "object",
      "properties": {
        "pids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": ["pids"],
      "additionalProperties": false
    },
    "AppCloseParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppCloseResult": {
      "type": "null"
    },
    "ElementCheckParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "qualname": {
          "type": "string"
        }
      },
      "required": ["file", "qualname"],
      "additionalProperties": false
    },
    "ElementCheckResult": {
      "$ref": "rpc.schema.json#/$defs/ElementResult"
    },
    "ElementHighlightParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "qualname": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["file", "qualname"],
      "additionalProperties": false
    },
    "ElementHighlightResult": {
      "$ref": "rpc.schema.json#/$defs/ElementResult"
    },
    "PageCheckParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "page": {
          "type": "string"
        }
      },
      "required": ["file", "page"],
      "additionalProperties": false
    },
    "PageCheckResult": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "rpc.schema.json#/$defs/CheckResult"
          }
        }
      },
      "required": ["results"],
      "additionalProperties": false
    },
    "FlowRunParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["file", "name"],
      "additionalProperties": false
    },
    "FlowRunResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "message": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["status", "durationMs"],
      "additionalProperties": false
    },
    "InspectRootsParams": {
      "type": "object",
      "properties": {
        "includeOtherApps": {
          "type": "boolean"
        },
        "foregroundForProcessId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "InspectRootsResult": {
      "type": "array",
      "items": {
        "$ref": "rpc.schema.json#/$defs/NodeInfo"
      }
    },
    "InspectRefreshParams": {
      "$ref": "rpc.schema.json#/$defs/InspectRootsParams"
    },
    "InspectRefreshResult": {
      "type": "object",
      "properties": {
        "nodes": {"$ref": "rpc.schema.json#/$defs/InspectRootsResult"},
        "status": {"$ref": "rpc.schema.json#/$defs/AppStatusResult"}
      },
      "required": ["nodes", "status"],
      "additionalProperties": false
    },
    "InspectPartialErrorData": {
      "type": "object",
      "properties": {
        "nodes": {"$ref": "rpc.schema.json#/$defs/InspectRootsResult"},
        "complete": {"const": false},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "message": {"type": "string"}
            },
            "required": ["index", "message"],
            "additionalProperties": false
          }
        }
      },
      "required": ["nodes", "complete", "errors"],
      "additionalProperties": false
    },
    "InspectChildrenParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "tree": {"enum": ["visual", "logical"], "description": "Opt into the requested tree; omit for the legacy UIA array."},
        "pageSize": {"type": "integer", "minimum": 1, "maximum": 200, "description": "Maximum children per page; defaults to 200."},
        "pageToken": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Continuation token from the preceding page."}
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectChildrenResult": {
      "anyOf": [
        {"type": "array", "items": {"$ref": "rpc.schema.json#/$defs/NodeInfo"}},
        {"type": "object", "properties": {"attachRequired": {"const": true}, "process": {"$ref": "common.schema.json#/$defs/ManagedProcessIdentity"}}, "required": ["attachRequired", "process"], "additionalProperties": false},
        {"type": "object", "properties": {"blocked": {"type": "object", "properties": {"code": {"type": "string"}, "hint": {"type": "string"}}, "required": ["code", "hint"], "additionalProperties": false}}, "required": ["blocked"], "additionalProperties": false},
        {"type": "object", "description": "One page of children when tree is supplied.", "properties": {"nodes": {"type": "array", "items": {"$ref": "rpc.schema.json#/$defs/NodeInfo"}}, "nextPageToken": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["nodes"], "additionalProperties": false}
      ]
    },
    "InspectPropertiesParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "full": {
          "type": "boolean",
          "description": "Read the complete property list and supported patterns; defaults to false."
        },
        "includeAncestors": {
          "type": "boolean",
          "description": "Include ancestors for revealing a picked object; defaults to false."
        },
        "include": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "Extra UI Automation property names to read when full is false, such as properties the user pinned."
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "NativeWindowStyle": {
      "type": "object",
      "description": "One decoded style: its name and the bits it stands for.",
      "properties": {
        "name": {"type": "string"},
        "value": {"type": "integer", "minimum": 0}
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "NativeWindowInfo": {
      "type": "object",
      "description": "Win32 facts about the HWND behind a UI Automation node. Optional fields are omitted when the system would not answer.",
      "properties": {
        "handle": {"type": "integer", "minimum": 1},
        "className": {"type": "string"},
        "text": {"type": "string", "description": "Window text, cut to 2000 characters; omitted for password boxes."},
        "styles": {"type": "array", "items": {"$ref": "rpc.schema.json#/$defs/NativeWindowStyle"}},
        "rawStyle": {"type": "integer", "minimum": 0},
        "unknownStyle": {"type": "integer", "minimum": 1, "description": "Style bits no name covers."},
        "exStyles": {"type": "array", "items": {"$ref": "rpc.schema.json#/$defs/NativeWindowStyle"}},
        "rawExStyle": {"type": "integer", "minimum": 0},
        "unknownExStyle": {"type": "integer", "minimum": 1},
        "controlId": {"type": "integer", "description": "Dialog control ID; only for child windows."},
        "processId": {"type": "integer", "minimum": 0},
        "threadId": {"type": "integer", "minimum": 0},
        "owner": {"type": "integer", "minimum": 0, "description": "Owner window handle; 0 when unowned."},
        "parent": {"type": "integer", "minimum": 0, "description": "Parent window handle; 0 for top-level windows."},
        "rect": {"$ref": "common.schema.json#/$defs/Rect"},
        "clientRect": {"$ref": "common.schema.json#/$defs/Rect"},
        "visible": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "topmost": {"type": "boolean"},
        "dpi": {"type": "integer", "minimum": 1}
      },
      "required": ["handle", "className", "styles", "rawStyle", "exStyles", "rawExStyle", "owner", "parent", "enabled", "topmost"],
      "additionalProperties": false
    },
    "InspectPropertiesResult": {

        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["data", "width", "height"],
      "additionalProperties": false
    },
    "InspectPreviewParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectPreviewResult": {
      "type": "object",
      "properties": {
        "element": { "$ref": "rpc.schema.json#/$defs/PreviewImage" },
        "window": { "$ref": "rpc.schema.json#/$defs/PreviewImage" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SuggestLocatorParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],

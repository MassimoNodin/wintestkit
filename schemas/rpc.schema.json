{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wintestkit.dev/schemas/rpc.schema.json",
  "$defs": {
    "InspectManagedIdentifyParams": {"type":"object","properties":{"nodeId":{"type":"string","minLength":1}},"required":["nodeId"],"additionalProperties":false},
    "InspectManagedIdentifyResult": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"},"executable":{"type":"string"},"runtime":{"enum":["net48","net8","net10",null]},"architecture":{"enum":["x86","x64","arm64","unknown"]},"wpfLoaded":{"type":"boolean"}},"required":["process","executable","runtime","architecture","wpfLoaded"],"additionalProperties":false},
    "InspectManagedAttachParams": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"}},"required":["process"],"additionalProperties":false},
    "InspectManagedAttachResult": {"$ref":"common.schema.json#/$defs/ManagedSession"},
    "InspectManagedStatusParams": {"type":"object","properties":{"process":{"$ref":"common.schema.json#/$defs/ManagedProcessIdentity"}},"required":["process"],"additionalProperties":false},
    "InspectManagedStatusResult": {"$ref":"common.schema.json#/$defs/ManagedSession"},
    "InspectManagedDetachParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId"],"additionalProperties":false},
    "InspectManagedDetachResult": {"type":"object","properties":{"detached":{"const":true}},"required":["detached"],"additionalProperties":false},
    "InspectManagedResolveParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"nodeId":{"type":"string","minLength":1}},"required":["sessionId","nodeId"],"additionalProperties":false},
    "InspectManagedResolveResult": {"$ref":"common.schema.json#/$defs/ManagedMapping"},
    "InspectManagedRootsParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId"],"additionalProperties":false},
    "InspectManagedRootsResult": {"$ref":"common.schema.json#/$defs/ManagedInspectorNodePage"},
    "InspectManagedChildrenParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"tree":{"enum":["visual","logical"]},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId","objectId","generation","tree"],"additionalProperties":false},
    "InspectManagedChildrenResult": {"$ref":"common.schema.json#/$defs/ManagedInspectorNodePage"},
    "InspectManagedMembersParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"pageSize":{"type":"integer","minimum":1,"maximum":200},"pageToken":{"type":"string","minLength":1,"maxLength":128}},"required":["sessionId","objectId","generation"],"additionalProperties":false},
    "InspectManagedMembersResult": {"$ref":"common.schema.json#/$defs/ManagedMemberPage"},
    "InspectManagedReadParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"paths":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedPath"}}},"required":["sessionId","objectId","generation","paths"],"additionalProperties":false},
    "InspectManagedReadResult": {"type":"object","properties":{"values":{"type":"array","maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedPathValue"}},"readId":{"type":"string","minLength":1,"maxLength":128}},"required":["values","readId"],"additionalProperties":false},
    "InspectManagedBindingsParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectId":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"integer","minimum":1},"memberKeys":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":1024}}},"required":["sessionId","objectId","generation","memberKeys"],"additionalProperties":false},
    "InspectManagedBindingsResult": {"type":"object","properties":{"bindings":{"type":"array","maxItems":32,"items":{"$ref":"common.schema.json#/$defs/ManagedBindingInfo"}}},"required":["bindings"],"additionalProperties":false},
    "InspectManagedReleaseParams": {"type":"object","properties":{"sessionId":{"type":"string","minLength":1,"maxLength":128},"objectIds":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"string","minLength":1,"maxLength":128}}},"required":["sessionId","objectIds"],"additionalProperties":false},
    "InspectManagedReleaseResult": {"type":"object","properties":{"releasedCount":{"type":"integer","minimum":0,"maximum":256}},"required":["releasedCount"],"additionalProperties":false},
    "ElementResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["found", "not_found", "ambiguous", "error"]
        },
        "element": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "diagnostic": {
          "$ref": "common.schema.json#/$defs/Diagnostic"
        },
        "message": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["status", "durationMs"],
      "additionalProperties": false
    },
    "NodeInfo": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "info": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "hasChildren": {
          "type": "boolean"
        }
      },
      "required": ["nodeId", "info", "hasChildren"],
      "additionalProperties": false
    },
    "Suggestion": {
      "type": "object",
      "properties": {
        "locator": {
          "$ref": "common.schema.json#/$defs/LocatorData"
        },
        "code": {
          "type": "string"
        },
        "attributeName": {
          "type": "string"
        },
        "helpers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attributeName": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "locator": {
                "$ref": "common.schema.json#/$defs/LocatorData"
              }
            },
            "required": ["attributeName", "code", "locator"],
            "additionalProperties": false
          }
        },
        "unique": {
          "type": "boolean"
        },
        "matchCount": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "string",
          "enum": ["automation_id", "name", "class_name", "within", "index"]
        },
        "window": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "locator": {
              "$ref": "common.schema.json#/$defs/WindowLocatorData"
            }
          },
          "required": ["code", "locator"],
          "additionalProperties": false
        }
      },
      "required": [
        "locator",
        "code",
        "attributeName",
        "helpers",
        "unique",
        "matchCount",
        "strategy"
      ],
      "additionalProperties": false
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["found", "not_found", "ambiguous", "error"]
        },
        "element": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "diagnostic": {
          "$ref": "common.schema.json#/$defs/Diagnostic"
        },
        "message": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "qualname": {
          "type": "string"
        }
      },
      "required": ["status", "durationMs", "qualname"],
      "additionalProperties": false
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "wintestkitVersion": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {"managedInspector": {"type": "boolean"}},
          "required": ["managedInspector"],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "found": {
              "type": "boolean"
            },
            "app": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "process": {
                  "type": "string"
                }
              },
              "required": ["path", "process"],
              "additionalProperties": false
            },
            "launch": {
              "type": "string"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reportDir": {
              "type": "string"
            }
          },
          "required": ["found", "launch", "timeout", "reportDir"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "wintestkitVersion", "python", "config"],
      "additionalProperties": false
    },
    "ShutdownParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ShutdownResult": {
      "type": "null"
    },
    "DiscoverParams": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "DiscoverResult": {
      "$ref": "discovery.schema.json#/$defs/DiscoveryResult"
    },
    "AppStatusParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppStatusResult": {
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "owned": {
          "type": "boolean",
          "description": "True only while the server still owns the exact PID set it launched."
        },
        "pids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "mainWindowTitle": {
          "type": "string"
        }
      },
      "required": ["running", "pids", "owned"],
      "additionalProperties": false
    },
    "AppLaunchParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppProcessesParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "RunningProcess": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "pids": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "windowTitle": { "type": "string" }
      },
      "required": ["name", "pids", "windowTitle"],
      "additionalProperties": false
    },
    "AppProcessesResult": {
      "type": "object",
      "properties": {
        "processes": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/RunningProcess" }
        }
      },
      "required": ["processes"],
      "additionalProperties": false
    },
    "AppLaunchResult": {
      "type": "object",
      "properties": {
        "pids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": ["pids"],
      "additionalProperties": false
    },
    "AppCloseParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AppCloseResult": {
      "type": "null"
    },
    "ElementCheckParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "qualname": {
          "type": "string"
        }
      },
      "required": ["file", "qualname"],
      "additionalProperties": false
    },
    "ElementCheckResult": {
      "$ref": "rpc.schema.json#/$defs/ElementResult"
    },
    "ElementHighlightParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "qualname": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["file", "qualname"],
      "additionalProperties": false
    },
    "ElementHighlightResult": {
      "$ref": "rpc.schema.json#/$defs/ElementResult"
    },
    "PageCheckParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "page": {
          "type": "string"
        }
      },
      "required": ["file", "page"],
      "additionalProperties": false
    },
    "PageCheckResult": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "rpc.schema.json#/$defs/CheckResult"
          }
        }
      },
      "required": ["results"],
      "additionalProperties": false
    },
    "FlowRunParams": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["file", "name"],
      "additionalProperties": false
    },
    "FlowRunResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "message": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["status", "durationMs"],
      "additionalProperties": false
    },
    "InspectRootsParams": {
      "type": "object",
      "properties": {
        "includeOtherApps": {
          "type": "boolean"
        },
        "foregroundForProcessId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "InspectRootsResult": {
      "type": "array",
      "items": {
        "$ref": "rpc.schema.json#/$defs/NodeInfo"
      }
    },
    "InspectRefreshParams": {
      "$ref": "rpc.schema.json#/$defs/InspectRootsParams"
    },
    "InspectRefreshResult": {
      "type": "object",
      "properties": {
        "nodes": {"$ref": "rpc.schema.json#/$defs/InspectRootsResult"},
        "status": {"$ref": "rpc.schema.json#/$defs/AppStatusResult"}
      },
      "required": ["nodes", "status"],
      "additionalProperties": false
    },
    "InspectPartialErrorData": {
      "type": "object",
      "properties": {
        "nodes": {"$ref": "rpc.schema.json#/$defs/InspectRootsResult"},
        "complete": {"const": false},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "message": {"type": "string"}
            },
            "required": ["index", "message"],
            "additionalProperties": false
          }
        }
      },
      "required": ["nodes", "complete", "errors"],
      "additionalProperties": false
    },
    "InspectChildrenParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectChildrenResult": {
      "type": "array",
      "items": {
        "$ref": "rpc.schema.json#/$defs/NodeInfo"
      }
    },
    "InspectPropertiesParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "full": {
          "type": "boolean",
          "description": "Read the complete property list and supported patterns; defaults to false."
        },
        "includeAncestors": {
          "type": "boolean",
          "description": "Include ancestors for revealing a picked object; defaults to false."
        },
        "include": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "Extra UI Automation property names to read when full is false, such as properties the user pinned."
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectPropertiesResult": {
      "type": "object",
      "properties": {
        "inspection": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/InspectionProperty"}
        },
        "info": {
          "$ref": "common.schema.json#/$defs/ElementInfo"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ancestors": {
          "type": "array",
          "items": {
            "$ref": "rpc.schema.json#/$defs/NodeInfo"
          }
        }
      },
      "required": ["info", "properties", "ancestors"],
      "additionalProperties": false
    },
    "InspectHighlightParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "bringToFront": {
          "type": "boolean"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectHighlightResult": {
      "type": "null"
    },
    "PreviewImage": {
      "type": "object",
      "properties": {
        "data": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["data", "width", "height"],
      "additionalProperties": false
    },
    "InspectPreviewParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectPreviewResult": {
      "type": "object",
      "properties": {
        "element": { "$ref": "rpc.schema.json#/$defs/PreviewImage" },
        "window": { "$ref": "rpc.schema.json#/$defs/PreviewImage" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SuggestLocatorParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "SuggestLocatorResult": {
      "$ref": "rpc.schema.json#/$defs/Suggestion"
    },
    "DefinitionMatch": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "qualname": { "type": "string" },
        "kind": { "enum": ["element", "elements", "window"] },
        "elementType": { "type": "string" },
        "locator": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "range": { "$ref": "common.schema.json#/$defs/Range" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "pageCount": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "qualname", "kind", "locator", "file", "line", "pages", "pageCount"],
      "additionalProperties": false
    },
    "DefinitionError": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["file", "message"],
      "additionalProperties": false
    },
    "InspectDefinitionsParams": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string"
        }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    },
    "InspectDefinitionsResult": {
      "type": "object",
      "properties": {
        "definitions": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/DefinitionMatch" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/DefinitionError" }
        },
        "pageCount": { "type": "integer", "minimum": 0 },
        "appRunning": { "type": "boolean" }
      },
      "required": ["definitions", "errors", "pageCount"],
      "additionalProperties": false
    },
    "NodeCoverage": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "first": { "type": "string" }
      },
      "required": ["count", "first"],
      "additionalProperties": false
    },
    "InspectCoverageParams": {
      "type": "object",
      "properties": {
        "nodeIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 500
        }
      },
      "required": ["nodeIds"],
      "additionalProperties": false
    },
    "InspectCoverageResult": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "object",
          "additionalProperties": { "$ref": "rpc.schema.json#/$defs/NodeCoverage" }
        },
        "pending": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["covered", "pending"],
      "additionalProperties": false
    },
    "AppStartingNotification": {
      "type": "object",
      "properties": {
        "stage": { "enum": ["process", "window"] }
      },
      "required": ["stage"],
      "additionalProperties": false
    },
    "SpyStartParams": {
      "type": "object",
      "properties": {"sessionId": {"type": "string", "minLength": 1}},
      "required": [],
      "additionalProperties": false
    },
    "SpyStartResult": {
      "type": "null"
    },
    "SpyStopParams": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "SpyStopResult": {
      "type": "null"
    },
    "SpyHoverNotification": {
      "type": "object",
      "properties": {
        "sessionId": {"type": "string", "minLength": 1},
        "node": {
          "$ref": "rpc.schema.json#/$defs/NodeInfo"
        }
      },
      "required": ["node"],
      "additionalProperties": false
    },
    "SpyPickedNotification": {
      "type": "object",
      "properties": {
        "sessionId": {"type": "string", "minLength": 1},
        "node": {
          "$ref": "rpc.schema.json#/$defs/NodeInfo"
        },
        "suggestion": {
          "$ref": "rpc.schema.json#/$defs/Suggestion"
        }
      },
      "required": ["node"],
      "additionalProperties": false
    },
    "SpyCancelledNotification": {
      "type": "object",
      "properties": {"sessionId": {"type": "string", "minLength": 1}},
      "required": [],
      "additionalProperties": false
    },
    "LogNotification": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["level", "message"],
      "additionalProperties": false
    }
  }
}

    },
    "SpyRepickResult": {"$ref": "rpc.schema.json#/$defs/SpyPickedNotification"},
    "SpyStartParams": {
      "type": "object",
      "properties": {
        "sessionId": {"type": "string", "minLength": 1},
        "tree": {"enum": ["visual", "logical"]},

    },
    "InspectCoverageParams": {
      "type": "object",
      "properties": {
        "nodeIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 500
        }
      },
      "required": ["nodeIds"],
      "additionalProperties": false
    },
    "InspectCoverageResult": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "object",
          "additionalProperties": { "$ref": "rpc.schema.json#/$defs/NodeCoverage" }
        },

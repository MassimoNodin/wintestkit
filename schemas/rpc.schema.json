          "type": "integer",
          "minimum": 1,
          "description": "Remember the foreground window belonging to this process or an ancestor and reactivate it after an element is picked."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SpyStartResult": {
      "type": "null"

      "type": "object",
      "properties": {
        "sessionId": {"type": "string", "minLength": 1},
        "attachRequired": {"const": true},
        "process": {"$ref": "common.schema.json#/$defs/ManagedProcessIdentity"},
        "blocked": {"type": "object", "properties": {"code": {"type": "string"}, "hint": {"type": "string"}}, "required": ["code", "hint"], "additionalProperties": false},
        "source": {"const": "uia"},
        "node": {
          "$ref": "rpc.schema.json#/$defs/NodeInfo"
        }
      },
      "required": ["node"],
      "additionalProperties": false
    },
    "SpyPickedNotification": {
      "type": "object",
      "properties": {
        "innerElement": {"type":"object","properties":{"type":{"type":"string"},"text":{"type":"string"}},"required":["type"],"additionalProperties":false},
        "point": {"type": "object", "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}, "required": ["x", "y"], "additionalProperties": false},
        "sessionId": {"type": "string", "minLength": 1},
        "attachRequired": {"const": true},
        "process": {"$ref": "common.schema.json#/$defs/ManagedProcessIdentity"},
        "blocked": {"type": "object", "properties": {"code": {"type": "string"}, "hint": {"type": "string"}}, "required": ["code", "hint"], "additionalProperties": false},
        "source": {"const": "uia"},
        "node": {
          "$ref": "rpc.schema.json#/$defs/NodeInfo"
        },
        "suggestion": {
          "$ref": "rpc.schema.json#/$defs/Suggestion"
        }
      },
      "required": ["node", "point"],
      "additionalProperties": false
    },
    "SpyCancelledNotification": {
      "type": "object",
      "properties": {"sessionId": {"type": "string", "minLength": 1}},
      "required": [],
      "additionalProperties": false
    },
    "LogNotification": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["level", "message"],
      "additionalProperties": false
    }
  }
